# Public site URL used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://yonixtools.com

# Base URL of the separate downloader backend (Phase 2). Leave empty until the
# backend is deployed: the downloader UI then states that downloading is not
# live yet instead of pretending to work.
NEXT_PUBLIC_DOWNLOADER_API_URL=

# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
