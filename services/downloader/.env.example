# YoniXTools downloader service. Copy to .env (never commit .env).
APP_ENV=production
TEMP_ROOT=/var/lib/yonixtools/tmp

# Comma-separated origins allowed to call the API from a browser.
# With same-origin /api proxying (recommended) this only matters for local dev.
CORS_ORIGINS=https://yonixtools.com,https://www.yonixtools.com
# Set to 1 only when running behind the bundled Nginx (it sets X-Real-IP).
TRUST_PROXY_HEADERS=1

# Concurrency and queue (sized for 2 vCPU / 2 GB)
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_EXTRACTIONS=3
MAX_QUEUED_JOBS=20
MAX_ACTIVE_JOBS_PER_CLIENT=2

# Limits
MAX_FILESIZE_MB=500
MAX_DURATION_SECONDS=10800
EXTRACT_TIMEOUT_SECONDS=45
JOB_TIMEOUT_SECONDS=600
FILE_TTL_SECONDS=900
JOB_TTL_SECONDS=1800
MIN_FREE_DISK_MB=1024
MAX_TEMP_USAGE_MB=4096
WORKER_MEMORY_MB=1536
MAX_ITEMS_PER_POST=20

# Rate limits per client IP per window
RATE_WINDOW_SECONDS=60
RATE_EXTRACT_PER_WINDOW=20
RATE_JOBS_PER_WINDOW=10
